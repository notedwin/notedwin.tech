{
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm design build && next dev",
    "build": "pnpm design build && next build",
    "start": "next start",
    "typecheck": "pnpm design build && tsc --noEmit && node design/checks/scale.mjs app/global.css",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "ui:open": "PLAYWRIGHT_BROWSERS_PATH=0 pnpm exec playwright-cli open --config=playwright-cli.json http://localhost:3000",
    "ui:shot": "PLAYWRIGHT_BROWSERS_PATH=0 pnpm exec playwright-cli screenshot --filename=.playwright-cli/screenshot.png",
    "design": "pnpm -F @notedwin/design",
    "design:push": "git subtree push --prefix=design https://gitea.notedwin.com/notedwin/design.git main",
    "design:pull": "git subtree pull --prefix=design https://gitea.notedwin.com/notedwin/design.git main",
    "design:status": "git fetch -q https://gitea.notedwin.com/notedwin/design.git main && if [ \"$(git rev-parse FETCH_HEAD^{tree})\" = \"$(git rev-parse HEAD:design)\" ]; then echo \"design/ matches gitea main\"; else echo \"design/ differs from gitea main ($(git rev-parse --short FETCH_HEAD)):\"; git diff --stat HEAD:design FETCH_HEAD; exit 1; fi"
  },
  "dependencies": {
    "@notedwin/design": "workspace:*",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "feed": "^6.0.0",
    "katex": "^0.19.0",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "porter2": "2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-tweet": "^3.3.1",
    "react-youtube": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "1.64.1",
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "^8.5.1",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": "24.x"
  }
}
